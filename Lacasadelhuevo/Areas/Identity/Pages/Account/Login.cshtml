@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}

<!DOCTYPE html>
<html lang="es">
<style>
  

:root {

    --primary: #f59e0b;
    --primary-dark: #d97706;

    --bg-dark: #0f172a;
    --bg-card: rgba(255,255,255,0.08);

    --text: #ffffff;
    --text-soft: #cbd5e1;

    --border: rgba(255,255,255,0.12);

    --shadow:
        0 10px 40px rgba(0,0,0,.35);

    --radius-xl: 30px;
    --radius-lg: 18px;

    --transition: .25s ease;
}

/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    min-height: 100vh;

    background:
        radial-gradient(circle at top left, #1e293b 0%, transparent 30%),
        radial-gradient(circle at bottom right, #7c2d12 0%, transparent 30%),
        linear-gradient(135deg, #020617, #0f172a);

    color: var(--text);

    overflow-x: hidden;
}

/* =========================
   WRAPPER
========================= */

.login-wrapper {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 70px;

    padding: 40px;
}

/* =========================
   BRANDING
========================= */

.login-branding {
    max-width: 480px;

    animation: fadeUp .7s ease;
}

.brand-icon {

    width: 90px;
    height: 90px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 42px;

    border-radius: 24px;

    background:
        linear-gradient(135deg, #f59e0b, #fbbf24);

    box-shadow:
        0 12px 30px rgba(245,158,11,.35);

    margin-bottom: 28px;
}

.brand-title {

    font-size: 64px;
    line-height: 1;

    font-weight: 800;

    margin-bottom: 24px;
}

.brand-title span {
    color: var(--primary);
}

.brand-subtitle {

    color: var(--text-soft);

    font-size: 17px;

    line-height: 1.7;

    margin-bottom: 34px;
}

.brand-features {

    display: flex;
    flex-direction: column;
    gap: 16px;
}

.brand-feature {

    display: flex;
    align-items: center;
    gap: 14px;

    background: rgba(255,255,255,0.05);

    border: 1px solid rgba(255,255,255,0.08);

    padding: 15px 18px;

    border-radius: 16px;

    backdrop-filter: blur(10px);

    transition: var(--transition);
}

.brand-feature:hover {

    transform: translateX(6px);

    background: rgba(255,255,255,0.08);
}

.brand-feature-dot {

    width: 10px;
    height: 10px;

    border-radius: 50%;

    background: var(--primary);
}

/* =========================
   LOGIN CARD
========================= */

.login-card {

    width: 100%;
    max-width: 470px;

    padding: 42px;

    border-radius: var(--radius-xl);

    background: var(--bg-card);

    border: 1px solid var(--border);

    backdrop-filter: blur(18px);

    box-shadow: var(--shadow);

    animation: fadeUp .8s ease;
}

.login-card-header h2 {

    font-size: 36px;

    font-weight: 700;

    margin-bottom: 8px;
}

.login-card-header p {

    color: var(--text-soft);

    margin-bottom: 28px;
}

.header-divider {

    width: 70px;
    height: 5px;

    border-radius: 999px;

    background:
        linear-gradient(to right, var(--primary), #fbbf24);

    margin-bottom: 32px;
}

/* =========================
   FORM
========================= */

.login-form {

    display: flex;
    flex-direction: column;

    gap: 24px;
}

.field-group {

    display: flex;
    flex-direction: column;

    gap: 10px;
}

.field-label {

    font-size: 14px;

    font-weight: 600;

    color: #f8fafc;
}

.field-wrapper {
    position: relative;
}

.field-icon {

    position: absolute;

    left: 18px;
    top: 50%;

    transform: translateY(-50%);

    color: #94a3b8;
}

.form-control {

    width: 100%;
    height: 58px;

    border-radius: 16px !important;

    border: 1px solid rgba(255,255,255,0.08) !important;

    background: rgba(255,255,255,0.06) !important;

    padding-left: 50px !important;
    padding-right: 50px !important;

    color: white !important;

    font-size: 15px;

    transition: var(--transition);
}

.form-control::placeholder {
    color: #94a3b8;
}

.form-control:focus {

    border-color: rgba(245,158,11,.8) !important;

    background: rgba(255,255,255,0.1) !important;

    box-shadow:
        0 0 0 4px rgba(245,158,11,.15) !important;
}

/* =========================
   PASSWORD TOGGLE
========================= */

.toggle-password {

    position: absolute;

    right: 16px;
    top: 50%;

    transform: translateY(-50%);

    border: none;
    background: transparent;

    color: #94a3b8;

    cursor: pointer;

    transition: var(--transition);
}

.toggle-password:hover {
    color: white;
}

/* =========================
   CHECKBOX
========================= */

.remember-row {

    display: flex;
    align-items: center;

    gap: 10px;

    color: var(--text-soft);
}

.form-check-input {

    width: 18px;
    height: 18px;

    cursor: pointer;
}

/* =========================
   BUTTON
========================= */

.btn-login {

    height: 58px;

    border: none;

    border-radius: 18px;

    background:
        linear-gradient(135deg, var(--primary), #fbbf24);

    color: #111827;

    font-weight: 700;

    font-size: 16px;

    transition: var(--transition);

    position: relative;

    overflow: hidden;
}

.btn-login:hover {

    transform: translateY(-2px);

    box-shadow:
        0 12px 28px rgba(245,158,11,.35);
}

.btn-login:active {
    transform: scale(.98);
}

/* =========================
   LINKS
========================= */

.register-link {

    text-align: center;

    color: var(--text-soft);
}

.register-link a {

    color: var(--primary);

    text-decoration: none;

    font-weight: 600;
}

.register-link a:hover {
    color: #fbbf24;
}

/* =========================
   ALERTS
========================= */

.alert-error {

    display: none;

    padding: 14px 16px;

    border-radius: 14px;

    background: rgba(239,68,68,.15);

    border: 1px solid rgba(239,68,68,.3);

    color: #fecaca;
}

.alert-error.show {
    display: block;
}

.field-error {

    color: #fca5a5;

    font-size: 13px;
}

/* =========================
   SPINNER
========================= */

.btn-spinner {
    display: none;
}

.spinner-ring {

    width: 18px;
    height: 18px;

    border: 2px solid rgba(0,0,0,.2);

    border-top-color: black;

    border-radius: 50%;

    animation: spin 1s linear infinite;
}

/* =========================
   ANIMATIONS
========================= */



/* =========================
   RESPONSIVE
========================= */




}
</style>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión — La Casa del Huevo</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body class="Imagen_Loguin">

    <main class="login-wrapper" role="main">

        <!-- ── Columna izquierda: branding ── -->
        <section class="login-branding" aria-label="Información del sistema">
            <div class="brand-icon" aria-hidden="true">🥚</div>

            <h1 class="brand-title">
                La Casa<br />
                <span>del Huevo</span>
            </h1>

            <p class="brand-subtitle">
                Sistema de gestión integral. Administrá stock, ventas y clientes desde un solo lugar.
            </p>

            <div class="brand-features" aria-label="Características del sistema">
                <div class="brand-feature">
                    <span class="brand-feature-dot" aria-hidden="true"></span>
                    Control de inventario en tiempo real
                </div>
                <div class="brand-feature">
                    <span class="brand-feature-dot" aria-hidden="true"></span>
                    Gestión de ventas y facturación
                </div>
                <div class="brand-feature">
                    <span class="brand-feature-dot" aria-hidden="true"></span>
                    Reportes y estadísticas detalladas
                </div>
            </div>
        </section>

        <!-- ── Columna derecha: formulario ── -->
        <div class="login-card">
            <div class="login-card-header">
                <h2>Bienvenido</h2>
                <p>Ingresá tus credenciales para continuar</p>
                <div class="header-divider" aria-hidden="true"></div>
            </div>

            <!-- Alerta de error general -->
            <div id="login-alert" class="alert-error" role="alert" aria-live="polite"></div>

            <form id="account" method="post" class="login-form" novalidate>

                <!-- Errores del modelo (server-side) -->
                <div asp-validation-summary="ModelOnly" class="alert-error show" role="alert"></div>

                <!-- Campo email -->
                <div class="field-group">
                    <label class="field-label" asp-for="Input.Email">Correo electrónico</label>
                    <div class="field-wrapper">
                        <!-- Ícono email -->
                        <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username"
                               placeholder="usuario@ejemplo.com" type="email" inputmode="email" aria-required="true" />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-error" role="alert"></span>
                </div>

                <!-- Campo contraseña -->
                <div class="field-group">
                    <label class="field-label" asp-for="Input.Password">Contraseña</label>
                    <div class="field-wrapper">
                        <!-- Ícono candado -->
                        <svg class="field-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                               placeholder="Tu contraseña" type="password" aria-required="true" />
                        <!-- Toggle mostrar contraseña -->
                        <button type="button" id="toggle-password" class="toggle-password"
                                aria-label="Mostrar contraseña">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="field-error" role="alert"></span>
                </div>

                <!-- Recordarme -->
                <div class="remember-row">
                    <input class="form-check-input" asp-for="Input.RememberMe" type="checkbox" id="remember-me" />
                    <label class="form-label" asp-for="Input.RememberMe">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <!-- Botón submit -->
                <button type="submit" id="btn-login" class="btn-login" aria-label="Iniciar sesión">
                    <span class="btn-text">Iniciar Sesión</span>
                    <span class="btn-spinner" aria-hidden="true">
                        <span class="spinner-ring"></span>
                    </span>
                </button>

                <!-- Link registro -->
                <p class="register-link">
                    ¿No tenés cuenta?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                        Registrate aquí
                    </a>
                </p>

            </form>
        </div>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>

</body>

</html>
