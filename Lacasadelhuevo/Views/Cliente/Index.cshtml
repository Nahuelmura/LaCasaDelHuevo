<link rel="stylesheet" href="~/css/Cliente.css" />

<div class="pg-header">
    <h1 class="pg-title">Clientes</h1>
    <p class="pg-subtitle">Registrá y gestioná tus clientes fácilmente.</p>
</div>



<div class="pg-card-split">
 
         <div class="pg-form-panel">
        <p class="pg-section-label">Datos del cliente</p>
        <input type="hidden" id="ClienteID" value="0">
        <div class="pg-grid-3">
            <div class="pg-field">
                <label>Nombre completo</label>
                <input type="text" id="nombre" placeholder="Ej: Juan Pérez">
            </div>
            <div class="pg-field">
                <label>Dirección</label>
                <input type="text" id="direccion" placeholder="Ej: Calle Falsa 123">
            </div>
            <div class="pg-field">
                <label>Localidad</label>
                <input type="text" id="localidad" placeholder="Ej: Córdoba">
            </div>
            <div class="pg-field">
                <label>DNI / CUIT</label>
                <input type="text" id="dni_cuit" placeholder="Ej: 20-12345678-9">
            </div>
            <div class="pg-field">
                <label>Teléfono</label>
                <input type="text" id="telefono" placeholder="Ej: 3563 412345">
            </div>
            <div class="pg-field">
                <label>Email</label>
                <input type="email" id="email" placeholder="Ej: juan@email.com">
            </div>
             <div class="pg-actions" style="margin-top:12px;">
                <button class="btn-secondary" type="button">Cancelar</button>
                <button class="btn-primary" type="button" onclick="GuardarCliente()">Guardar cliente</button>
            </div>
        </div>
    </div>      
</div>

<div class="pg-card">
<div class="pg-header-row">
    <p class="pg-section-label">
        <i class="fas fa-users me-2"></i>Listado de clientes
    </p>
     <div  class="pg-form-filter">
            <div class="pg-field">
                <label>Filtrar por nombre</label>
                <input type="text" id="filtroNombre" placeholder="Ej: Juan Pérez">
            </div>
           
    </div>
</div>

    <div class="table-responsive">
        <table class="tbl-productos">
            <thead>
                <tr>
                    <th><i class="fas fa-user me-2"></i>Nombre</th>
                    <th><i class="fas fa-map-marker-alt me-2"></i>Dirección</th>
                    <th><i class="fas fa-city me-2"></i>Localidad</th>
                    <th><i class="fas fa-id-card me-2"></i>DNI / CUIT</th>
                    <th><i class="fas fa-phone me-2"></i>Teléfono</th>
                    <th><i class="fas fa-envelope me-2"></i>Email</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="clientesTableBody"></tbody>
        </table>

        <div id="tablaVacia" class="text-center py-5 d-none">
            <i class="fas fa-users fa-3x mb-3" style="color:#334155; opacity:0.5"></i>
            <p class="fw-semibold" style="color:var(--text-soft)">No hay clientes registrados</p>
            <p style="font-size:0.9rem; color:#475569">Agregá uno usando el formulario de arriba.</p>
        </div>
    </div>
</div>
    <div id="tablaVacia" class="text-center py-5 text-muted d-none">
        <i class="fas fa-users fa-3x mb-3 opacity-25"></i>
        <p class="fw-semibold">No hay clientes registrados</p>
        <p style="font-size:0.9rem">Agregá uno usando el formulario de arriba</p>
    </div>
</div>


<!-- Modal para editar cliente -->
<div class="modal fade" id="modalEditarCliente" tabindex="-1" aria-labelledby="modalEditarClienteLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content pg-modal-content">

            <div class="modal-header pg-modal-header">
                <h5 class="modal-title pg-modal-title" id="modalEditarClienteLabel">Editar cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" style="padding:1.25rem">
                <p class="pg-section-label">Datos del cliente</p>
                <input type="hidden" id="ClienteIDModal" value="0">
                <div class="pg-grid-3">
                    <div class="pg-field">
                        <label>Nombre completo</label>
                        <input type="text" id="nombreModal" placeholder="Ej: Juan Pérez">
                    </div>
                    <div class="pg-field">
                        <label>Dirección</label>
                        <input type="text" id="direccionModal" placeholder="Ej: Calle Falsa 123">
                    </div>
                    <div class="pg-field">
                        <label>Localidad</label>
                        <input type="text" id="localidadModal" placeholder="Ej: Córdoba">
                    </div>
                    <div class="pg-field">
                        <label>DNI / CUIT</label>
                        <input type="text" id="dni_cuitModal" placeholder="Ej: 20-12345678-9">
                    </div>
                    <div class="pg-field">
                        <label>Teléfono</label>
                        <input type="text" id="telefonoModal" placeholder="Ej: 3563 412345">
                    </div>
                    <div class="pg-field">
                        <label>Email</label>
                        <input type="email" id="emailModal" placeholder="Ej: juan@email.com">
                    </div>
                </div>

                <div class="form-check form-switch mt-3">
                    <input class="form-check-input" type="checkbox" id="estadoClienteModal"
                           style="width:3rem; height:1.5rem; cursor:pointer;">
                    <label class="form-check-label fw-bold ms-2 text-success" id="estadoClienteLabel"
                           for="estadoClienteModal">Activo</label>
                </div>
            </div>

            <div class="modal-footer pg-modal-footer">
                <button class="btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn-primary" onclick="GuardarCliente()">Guardar cliente</button>
            </div>

        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

@section Scripts {
    <script src="~/js/Cliente.1.0.0.js"></script>
}