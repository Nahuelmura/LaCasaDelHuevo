@{
    ViewData["Title"] = "Productos";
}

<div class="pg-header">
    <h1 class="pg-title">Productos</h1>
    <p class="pg-subtitle">Registrá y gestioná tu inventario de forma rápida.</p>
</div>

                <div class="">

                    <!-- ── CARD PRINCIPAL: franja lateral + formulario ── -->
                    <div class="pg-card-split">

                        <div class="pg-form-panel">
                            <p class="pg-section-label">Datos del producto</p>
                            <input type="hidden" id="ProductoID" value="0">
                            <div class="pg-grid-3">
                    <div class="pg-field">
                        <label>Código</label>
                        <input type="text" id="codigo" class="soloNumeros" placeholder="Ej: P001">
                    </div>
                    <div class="pg-field">
                        <label>Descripción</label>
                        <input type="text" id="descripcion" placeholder="Ej: Producto 1">
                    </div>
                    <div class="pg-field">
                        <label>Observación</label>
                        <input type="text" id="observacion" placeholder="Ej: Observación del producto">
                    </div>
                    <div class="pg-field">
                        <label>Cantidad</label>
                        <input type="number" id="cantidad" placeholder="10">
                    </div>
                    <div class="pg-field">
                        <label>Precio de costo</label>
                        <input type="number" id="precioCosto" placeholder="100.00">
                    </div>
                    <div class="pg-field">
                        <label>Precio de venta</label>
                        <input type="number" id="precioVenta" placeholder="200.00">
                    </div>
                    <div class="pg-field">
                        <label>Fecha de ingreso</label>
                        <input type="date" id="fechaIngreso">
                    </div>
                </div>

                <!-- {{-- Botones FUERA del grid --}} -->
                <div class="pg-actions">
                    <button class="btn-secondary" type="button">Cancelar</button>
                    <button class="btn-primary" type="button" onclick="GuardarProducto()">Guardar producto</button>
                </div>

           
           
        </div>
    </div>


    <!-- ── MODAL EDITAR ── -->
    <div class="modal fade" id="modalEditarProducto" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content pg-modal-content">

                <div class="modal-header pg-modal-header">
                    <h5 class="modal-title pg-modal-title">Editar producto</h5>
                    <button class="btn-close" data-bs-dismiss="modal" onclick="cerrarModal()"></button>
                </div>

                <div class="modal-body" style="padding:1.25rem">
                    <p class="pg-section-label">Datos del producto</p>
                    <input type="hidden" id="ProductoIDModal">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="pg-label">Código</label>
                            <input type="text" class="pg-input form-control" id="codigoModal" placeholder="P001">
                        </div>
                        <div class="col-md-9">
                            <label class="pg-label">Descripción</label>
                            <input type="text" class="pg-input form-control" id="descripcionModal"
                                   placeholder="Ej: Producto 1">
                        </div>
                        <div class="col-md-4">
                            <label class="pg-label">Cantidad</label>
                            <input type="text" class="pg-input form-control cantidad-input" id="cantidadModal"
                                   placeholder="10">
                        </div>
                        <div class="col-md-4">
                            <label class="pg-label">Precio costo</label>
                            <input type="text" class="pg-input form-control precio-input" id="precioCostoModal"
                                   placeholder="100.00">
                        </div>
                        <div class="col-md-4">
                            <label class="pg-label">Precio venta</label>
                            <input type="text" class="pg-input form-control precio-input" id="precioVentaModal"
                                   placeholder="200.00">
                        </div>
                        <div class="col-md-8">
                            <label class="pg-label">Observación</label>
                            <input type="text" class="pg-input form-control" id="observacionModal"
                                   placeholder="Observación del producto">
                        </div>
                        <div class="col-md-4">
                            <label class="pg-label">Fecha de ingreso</label>
                            <input type="date" class="pg-input form-control" id="fechaIngresoModal">
                        </div>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" id="estadoProductoModal">
                        <label id="estadoProductoLabel"
                               class="form-check-label fw-bold ms-2 text-success">Activo</label>
                    </div>
                </div>

                <div class="modal-footer pg-modal-footer">
                    <button class="btn-secondary" data-bs-dismiss="modal" onclick="cerrarModal()">Cerrar</button>
                    <button class="btn-primary" onclick="GuardarProducto()">Guardar</button>
                </div>

            </div>
        </div>
    </div>


   <div class="pg-card">
    <div class="pg-header-row">
    <p class="pg-section-label">
        <i class="fas fa-users me-2"></i>Listado de clientes
    </p>

        <div class="pg-filter-row">
            <div class="pg-field">
                <label class="pg-label">Filtrar por nombre</label>
                <input type="text" class="pg-input" id="filtroNombreModal" placeholder="Buscar por nombre">
            </div>
            <div class="pg-field">
                <label class="pg-label">Fecha desde</label>
                <input type="date" class="pg-input" id="fechaInicio">
            </div>
            <div class="pg-field">
                <label class="pg-label">Fecha hasta</label>
                <input type="date" class="pg-input" id="fechaFin">
            </div>
        </div>
    </div>
        <div class="table-responsive">
    <table class="tbl-productos">
        <thead>
            <tr>
                <th><i class="fas fa-barcode me-2"></i>Código</th>
                <th><i class="fas fa-box me-2"></i>Descripción</th>
                <th><i class="fas fa-comment me-2"></i>Observación</th>
                <th><i class="fas fa-cubes me-2"></i>Cantidad</th>
                <th><i class="fas fa-tag me-2"></i>Precio costo</th>
                <th><i class="fas fa-dollar-sign me-2"></i>Precio venta</th>
                <th><i class="fas fa-calendar me-2"></i>Fecha ingreso</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody id="tbody-producto"></tbody>
    </table>

    <div id="tablaVaciaProducto" class="text-center py-5 d-none">
        <i class="fas fa-box-open fa-3x mb-3" style="color:#334155; opacity:0.5"></i>
        <p class="fw-semibold" style="color:var(--text-soft)">No hay productos registrados</p>
        <p style="font-size:0.9rem; color:#475569">Agregá uno usando el formulario de arriba.</p>
    </div>
</div>
</div>

@section Scripts {
    <script src="~/js/Producto.1.0.0.js"></script>
}