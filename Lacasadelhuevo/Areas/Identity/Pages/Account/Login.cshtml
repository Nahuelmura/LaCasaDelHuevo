@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - La Casa del Huevo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body class="Imagen_Loguin">

    <div class="container px-4 py-5 text-center text-lg-start my-5">
        <div class="row gx-lg-5 align-items-center mb-5">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <h1 class="my-5 display-5 fw-bold ls-tight" style="color:rgb(229, 229, 216)">
                    La Casa del Huevo<br />
                    <span>Inicia sesión en tu cuenta</span>
                </h1>
            </div>
            <div class="col-lg-6 mb-5 mb-lg-0">
                <div class="cardIngreso">
                    <div class="card-body px-4 py-5 color">
                        <form id="account" method="post">
                            <h2 class="text-center Textobohemia" style="color:rgb(255, 255, 255)">Ingreso</h2>
                            <hr />
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                            <div class="form-outline mb-3">
                                <input asp-for="Input.Email" class="form-control bg-white" autocomplete="username" placeholder="Correo" />
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                            <div class="form-outline mb-3">
                                <input asp-for="Input.Password" class="form-control bg-white" autocomplete="current-password" placeholder="Contraseña" />
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>
                            <div class="form-check d-flex justify-content-center mb-3">
                                <input class="form-check-input me-2" asp-for="Input.RememberMe" />
                                <label asp-for="Input.RememberMe" class="form-label">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                            </div>
                            <button type="submit" class="btn btn-light btn-block">Iniciar Sesión</button>
                            <div class="text-center mt-3">
                                <p>
                                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registrar nuevo usuario</a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

</body>
</html>